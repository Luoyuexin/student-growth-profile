!data_source/import_template.csv

# 云端大模型密钥配置（含 API Key，绝不入库）
config_setting/llm_config.yaml

# 虚拟环境
venv/
.venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
